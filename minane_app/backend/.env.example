# Exemple de configuration .env pour Minane Cargo Backend
# Copiez ce fichier en .env et remplissez les valeurs réelles
# NE JAMAIS committer le fichier .env réel

# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/minane_db?schema=public"

# Port du serveur
PORT=5050

# Clé secrète JWT — OBLIGATOIRE: générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REMPLACEZ_PAR_UNE_VRAIE_CLE_DE_64_BYTES_GENEREE_AU_HASARD"

# Identifiants de la Direction Administrateur
ADMIN_EMAIL="admin@votredomaine.sn"
ADMIN_PASSWORD="MotDePasseFort2026!"
ADMIN_NAME="Gestionnaire Minane Cargo"

# Environnement (development | production)
NODE_ENV="development"

# Origines autorisées pour CORS (séparées par virgule)
# En production: votre domaine exact, ex: https://minane-cargo.onrender.com
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:5050"

# URL publique de l'application (pour générer les liens de suivi WhatsApp)
APP_URL="https://minane-cargo-app.blackcoretech.duckdns.org"

# Numéro officiel WhatsApp Dakar (format international avec indicatif)
PHONE_DAKAR="+221 70 596 12 76"


