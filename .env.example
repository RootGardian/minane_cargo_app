# ==============================================================================
# MINANE CARGO — Variables d'Environnement de Production (Serveur / VPS)
# ==============================================================================

# Clé de chiffrement des tokens administrateur (obligatoire en production, 32+ caractères)
JWT_SECRET=generer_une_cle_secrete_aleatoire_de_plus_de_32_caracteres

# Port d'écoute du serveur (par défaut : 5000)
PORT=5000
NODE_ENV=production

# Identifiants de l'administrateur initial (créé automatiquement au premier démarrage)
ADMIN_EMAIL=admin@minanecargo.sn
ADMIN_PASSWORD=AdminMinane2026!
ADMIN_NAME=Gestionnaire Minane Cargo

# Optionnel : si vous utilisez une base de données externe (ex: Neon, Supabase, Cloud SQL)
# Laissez vide ou commentez cette ligne pour utiliser la base PostgreSQL embarquée dans Docker
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
